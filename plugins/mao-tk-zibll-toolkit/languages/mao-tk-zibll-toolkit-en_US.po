msgid "无法保存下载链接签名密钥，请检查数据库写入权限。"
msgstr "Could not save the download signing key. Please check database write access."

msgid "无法保存扫描位置，重试时会跳过已处理的引用。"
msgstr "Could not save the scan position. Completed references are skipped on retry."

msgid "无法备份下载引用，未修改对应文章或下载设置。"
msgstr "Could not back up the download references. The associated post or settings were not modified."

msgid "无法读取下载引用密钥，未写入该引用。"
msgstr "Could not read the download reference key. The reference was not written."

msgid "无法读取旧下载引用，未完成本批扫描。"
msgstr "Could not read the older download references. This scan batch did not finish."

msgid "无法读取旧凭据。请用原值重新保存后再试。"
msgstr "The previous credentials could not be read. Re-enter their original values and try again."

msgid "本批转换了 %d 个下载引用；请继续下一批。"
msgstr "Converted %d download references in this batch. Continue with the next batch."

msgid "本次测试失败，当前配置保留上次通过的结果。"
msgstr "This test failed. The current configuration retains its last successful result."

msgid "本轮扫描完成，本批转换了 %d 个下载引用。"
msgstr "Scan complete. This batch converted %d download references."

msgid "本轮未完成，请检查下载引用密钥和数据库后重试。"
msgstr "The scan did not complete. Check the download reference key and database before trying again."

msgid "没有需要迁移的 R2 凭据。"
msgstr "No R2 credentials require migration."

msgid "测试期间媒体配置已变更，请重新测试。"
msgstr "The media configuration changed during the test. Run the test again."

msgid "继续准备回退"
msgstr "Continue preparing rollback"

msgid "继续重新签名"
msgstr "Continue re-signing"

msgid "该下载卡片不可用：链接已失效，或卡片放在了不支持公开下载的区块中。"
msgstr "This download is unavailable: the link has expired, or the card is placed in a block that does not support public downloads."

msgid "请先配置独立加密密钥并启用 PHP OpenSSL。"
msgstr "Configure a dedicated encryption key and enable PHP OpenSSL first."

msgid "迁移前请在服务器配置 MAO_TK_TOOLKIT_SECRET_KEY 并启用 OpenSSL。"
msgstr "Configure MAO_TK_TOOLKIT_SECRET_KEY on the server and enable OpenSSL before migrating."

msgid "迁移已保存凭据"
msgstr "Migrate saved credentials"

msgid "遇到正在修改的文章或下载设置。本批已成功的修改保留；继续时会重新读取冲突记录。"
msgstr "A post or download setting was edited during the scan. Completed changes are kept. The conflicting record is read again on retry."
