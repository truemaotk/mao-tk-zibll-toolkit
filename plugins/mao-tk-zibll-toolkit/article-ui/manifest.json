      "baseline_version": "1.1.1",
      "automatic_cover_fetch": false
    }
  },
  "shared_script": "assets/article-ui/article-ui.js",
  "runtime": "inc/article-ui/class-runtime.php",
  "init_api": "window.MaoTKArticleUI.init(container)",
  "destroy_api": "window.MaoTKArticleUI.destroy(container)",
