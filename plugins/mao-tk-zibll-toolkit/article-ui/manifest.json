{
  "host": "mao-tk-zibll-toolkit",
  "host_version": "1.7.0",
  "source_version": "1.0.0",
  "adapter_version": "1.0.2",
  "default_enabled": true,
  "requires": {
    "html_api": "WordPress 6.2+",
    "theme": "Zibll parent directory zibll or child theme; exact current source/runtime not provided"
